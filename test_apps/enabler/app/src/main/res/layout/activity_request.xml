<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".RequestActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/request_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="?android:attr/actionBarSize"
        android:textColor="#000000"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/requests_toolbar_title"
            android:textColor="#000000" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:id="@+id/request_scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/request_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            tools:context=".RequestActivity"
            android:background="#FFFFFF"
            android:fitsSystemWindows="true">

            <ImageView
                android:id="@+id/progress_bar_1_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintHorizontal_bias="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv"
                app:srcCompat="@drawable/progress_bar_circle_checked" />

            <TextView
                android:id="@+id/progress_bar_1_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Profile"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_1_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_1_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_1_iv" />

            <View
                android:id="@+id/progress_bar_divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#000000"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_1_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv" />

            <ImageView
                android:id="@+id/progress_bar_2_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/progress_bar_circle_2_colour" />

            <TextView
                android:id="@+id/progress_bar_2_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Requests"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_2_iv" />

            <View
                android:id="@+id/progress_bar_divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#000000"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_3_iv"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv" />

            <ImageView
                android:id="@+id/progress_bar_3_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.6"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv"
                app:srcCompat="@drawable/progress_bar_circle_3" />

            <TextView
                android:id="@+id/progress_bar_3_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Complete"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_3_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_3_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_3_iv" />

            <TextView
                android:id="@+id/header_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/requests_header"
                android:textColor="#000000"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_2_tv" />

            <TextView
                android:id="@+id/subheader_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/requests_subheader"
                android:textColor="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_tv" />

            <Spinner
                android:id="@+id/btnTransactionType"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:dropDownVerticalOffset="50dp"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="16dp"
                android:paddingVertical="10dp"
                android:paddingLeft="10dp"
                android:hint="Transaction Type"
                android:elevation="2dp"
                android:textColorHint="#000000"
                android:text="@string/requests_transaction_type_spinner"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@color/white"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/subheader_tv"
                style="?android:attr/button" />

            <Spinner
                android:id="@+id/btnInvokingMethod"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:dropDownVerticalOffset="50dp"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:paddingVertical="10dp"
                android:paddingLeft="10dp"
                android:hint="Invoking Method"
                android:elevation="2dp"
                android:textColorHint="#000000"
                android:text="@string/requests_invoking_method_spinner"
                android:textAlignment="textStart"
                android:textAllCaps="false"
                android:textColor="#000000"
                android:background="@drawable/spinner_bg"
                android:popupBackground="@color/white"
                android:spinnerMode="dropdown"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/btnTransactionType" />

            <EditText
                android:id="@+id/request_name_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_name_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_pen"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/btnInvokingMethod"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/request_name_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="Request Name Error Text"
                android:textColor="@android:color/holo_red_light"
                app:layout_constraintTop_toBottomOf="@+id/request_name_et"
                app:layout_constraintStart_toStartOf="parent" />

            <View
                android:id="@+id/divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:background="#EAEAEA"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/request_name_error_tv" />

            <CheckBox
                android:id="@+id/request_prefill_checkbox"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/requests_prefill_checkbox"
                android:textColor="#808080"
                android:buttonTint="#EAEAEA"
                android:buttonTintMode="src_in"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_1" />

            <EditText
                android:id="@+id/request_amount_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_amount_hint"
                android:textColorHint="#808080"
                android:inputType="numberDecimal"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                app:layout_constraintTop_toBottomOf="@+id/request_prefill_checkbox"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_reference_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_reference_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                app:layout_constraintTop_toBottomOf="@+id/request_amount_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_acc_number_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:hint="@string/requests_account_number_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_account_number"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_reference_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_id_number_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_id_number_hint"
                android:textColorHint="#808080"
                android:inputType="number"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_person_plus"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_acc_number_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/request_id_number_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="Request ID Number Error Text"
                android:textColor="@android:color/holo_red_light"
                app:layout_constraintTop_toBottomOf="@+id/request_id_number_et"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/request_max_collection_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_max_coll_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_coin_hand"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_id_number_error_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_debit_order_day_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_debit_order_day_hint"
                android:textColorHint="#808080"
                android:inputType="number"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_calendar"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_max_collection_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <TextView
                android:id="@+id/request_debit_order_day_error_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="10dp"
                android:text="Request Debit Order Day Error Text"
                android:textColor="@android:color/holo_red_light"
                app:layout_constraintTop_toBottomOf="@+id/request_debit_order_day_et"
                app:layout_constraintStart_toStartOf="parent" />

            <EditText
                android:id="@+id/request_creditor_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_creditor_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_creditor"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_debit_order_day_error_tv"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_contract_reference_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_contract_reference_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_file_logo_plain"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_creditor_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <EditText
                android:id="@+id/request_instalment_amount_et"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="10dp"
                android:hint="@string/requests_instalment_amount_hint"
                android:textColorHint="#808080"
                android:inputType="text"
                android:textColor="#000000"
                android:background="@drawable/edit_text_border_grey"
                android:padding="15dp"
                android:drawableLeft="@drawable/ic_coin_hand"
                android:drawablePadding="10dp"
                app:layout_constraintTop_toBottomOf="@+id/request_contract_reference_et"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <View
                android:id="@+id/divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                android:background="#EAEAEA"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/request_instalment_amount_et" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/instalmentVisibility_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:context=".RequestActivity"
                android:background="@drawable/edit_text_border_grey"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginTop="20dp"
                app:layout_constraintTop_toBottomOf="@+id/divider_2"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" >

                <ImageView
                    android:id="@+id/instalmentVisibility_iv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintTop_toTopOf="@+id/instalmentVisibility_tv"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/instalmentVisibility_tv"
                    app:srcCompat="@drawable/ic_eye" />

                <TextView
                    android:id="@+id/instalmentVisibility_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/requests_instalment_visibility_textview"
                    android:textColor="#808080"
                    android:textSize="20sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.3"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/instalmentVisibilitySub_tv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/requests_instalment_visibility_sub_textview"
                    android:textColor="#808080"
                    app:layout_constraintStart_toStartOf="@+id/instalmentVisibility_tv"
                    app:layout_constraintTop_toBottomOf="@+id/instalmentVisibility_tv" />

                <RadioButton
                    android:id="@+id/rbnInstalmentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/requests_instalment_amount_radio_button"
                    android:textColor="#808080"
                    android:buttonTint="#DA29B2"
                    app:layout_constraintStart_toStartOf="@+id/rbnMaxInstalmentAmount"
                    app:layout_constraintTop_toBottomOf="@+id/instalmentVisibilitySub_tv" />

                <RadioButton
                    android:id="@+id/rbnMaxInstalmentAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="@string/requests_max_instalment_amount_radio_button"
                    android:textColor="#808080"
                    android:buttonTint="#DA29B2"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/rbnInstalmentAmount" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <Button
                android:id="@+id/skip_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="16dp"
                android:background="#FFFFFF"
                android:text="@string/requests_button_skip"
                android:textAllCaps="false"
                android:textColor="#DA29B2"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/instalmentVisibility_layout"
                style="?android:attr/borderlessButtonStyle" />

            <Button
                android:id="@+id/next_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/gradient_button"
                android:text="@string/requests_button_next"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/skip_btn" />

            <Button
                android:id="@+id/save_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/gradient_button"
                android:text="@string/requests_button_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/next_btn" />

            <Button
                android:id="@+id/cancel_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="16dp"
                android:background="#FFFFFF"
                android:text="@string/requests_button_cancel"
                android:textAllCaps="false"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/save_btn"
                style="?android:attr/borderlessButtonStyle" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
