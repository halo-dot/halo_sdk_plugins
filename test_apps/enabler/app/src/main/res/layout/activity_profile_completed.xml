                app:layout_constraintTop_toTopOf="@+id/profile_contract_reference_number_tv" />

            <TextView
                android:id="@+id/profile_instalment_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_instalment_amount"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_contract_reference_number_tv" />

            <TextView
                android:id="@+id/profile_instalment_amount_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Instalment Amount"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_instalment_amount_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_instalment_amount_tv" />

            <TextView
                android:id="@+id/profile_instalment_visibility_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_instalment_visibility"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_instalment_amount_tv" />

            <TextView
                android:id="@+id/profile_instalment_visibility_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Instalment Visibility"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_instalment_visibility_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_instalment_visibility_tv" />

            <Button
                android:id="@+id/save_btn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="16dp"
                android:layout_marginTop="30dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/gradient_button"
                android:text="@string/profile_completed_button_save"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_instalment_visibility_value_tv" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>

