<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fitsSystemWindows="true"
    tools:context=".ProfileCompletedActivity">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/profile_completed_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFFFFF"
        android:minHeight="?android:attr/actionBarSize"
        android:textColor="#000000"
        android:theme="@style/ThemeOverlay.AppCompat.Light"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:popupTheme="@style/ThemeOverlay.AppCompat.Light">

        <TextView
            android:id="@+id/toolbar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/profile_completed_toolbar_title"
            android:textColor="#000000" />

    </androidx.appcompat.widget.Toolbar>

    <ScrollView
        android:id="@+id/profile_completed_scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/profile_completed_toolbar"
        app:layout_constraintBottom_toBottomOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#FFFFFF"
            android:fitsSystemWindows="true"
            tools:context=".ProfileCompletedActivity">

            <ImageView
                android:id="@+id/progress_bar_1_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintHorizontal_bias="0.4"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv"
                app:srcCompat="@drawable/progress_bar_circle_checked" />

            <TextView
                android:id="@+id/progress_bar_1_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/profile_completed_textview_progress_bar_1"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_1_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_1_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_1_iv" />

            <View
                android:id="@+id/progress_bar_divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#000000"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_1_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv" />

            <ImageView
                android:id="@+id/progress_bar_2_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:srcCompat="@drawable/progress_bar_circle_checked" />

            <TextView
                android:id="@+id/progress_bar_2_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/profile_completed_textview_progress_bar_2"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_2_iv" />

            <View
                android:id="@+id/progress_bar_divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="#000000"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toStartOf="@+id/progress_bar_3_iv"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv" />

            <ImageView
                android:id="@+id/progress_bar_3_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="@+id/progress_bar_2_iv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.6"
                app:layout_constraintStart_toEndOf="@+id/progress_bar_2_iv"
                app:layout_constraintTop_toTopOf="@+id/progress_bar_2_iv"
                app:srcCompat="@drawable/progress_bar_circle_3_colour" />

            <TextView
                android:id="@+id/progress_bar_3_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="@string/profile_completed_textview_progress_bar_3"
                android:textColor="#000000"
                app:layout_constraintEnd_toEndOf="@+id/progress_bar_3_iv"
                app:layout_constraintStart_toStartOf="@+id/progress_bar_3_iv"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_3_iv" />

            <TextView
                android:id="@+id/header_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="20dp"
                android:text="@string/profile_completed_header"
                android:textColor="#000000"
                android:textSize="25sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/progress_bar_2_tv" />

            <TextView
                android:id="@+id/subheader_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_subheader"
                android:textColor="#808080"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/header_tv" />

            <ImageView
                android:id="@+id/profile_env_iv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="15dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/subheader_tv"
                app:srcCompat="@drawable/ic_env_dev"
                android:contentDescription="@string/profile_completed_imageview_description" />

            <TextView
                android:id="@+id/profile_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="TextView"
                android:textColor="#000000"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@+id/profile_env_iv"
                app:layout_constraintStart_toEndOf="@+id/profile_env_iv"
                app:layout_constraintTop_toTopOf="@+id/profile_env_iv" />

            <View
                android:id="@+id/divider_1"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="10dp"
                android:background="#EAEAEA"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_env_iv" />

            <TextView
                android:id="@+id/profile_env_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_environment"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_1" />

            <TextView
                android:id="@+id/profile_merchant_id_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_merchant_id"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_env_tv" />

            <TextView
                android:id="@+id/profile_api_key_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_api_key"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_password_value_tv" />

            <TextView
                android:id="@+id/profile_username_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_username"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_merchant_id_tv" />

            <TextView
                android:id="@+id/profile_password_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_passcode"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_username_tv" />

            <TextView
                android:id="@+id/profile_env_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Environment"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_env_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_env_tv" />

            <TextView
                android:id="@+id/profile_merchant_id_value_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:gravity="right"
                android:maxLines="4"
                android:text="Merchant ID"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/profile_merchant_id_tv"
                app:layout_constraintTop_toTopOf="@+id/profile_merchant_id_tv" />

            <TextView
                android:id="@+id/profile_api_key_value_tv"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginEnd="16dp"
                android:ellipsize="end"
                android:gravity="right"
                android:maxLines="4"
                android:text="API Key"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toEndOf="@+id/profile_api_key_tv"
                app:layout_constraintTop_toTopOf="@+id/profile_api_key_tv" />

            <TextView
                android:id="@+id/profile_username_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Username"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_username_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_username_tv" />

            <TextView
                android:id="@+id/profile_password_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Password"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_password_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_password_tv" />

            <View
                android:id="@+id/divider_2"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="40dp"
                android:layout_marginTop="15dp"
                android:background="#EAEAEA"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_api_key_value_tv" />

            <TextView
                android:id="@+id/profile_request_name_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="15dp"
                android:text="@string/profile_completed_textview_request_name"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/divider_2" />

            <TextView
                android:id="@+id/profile_request_name_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Request Name"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_request_name_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_request_name_tv" />

            <TextView
                android:id="@+id/profile_transaction_type_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_transaction_type"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_request_name_value_tv" />

            <TextView
                android:id="@+id/profile_transaction_type_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Transaction Type"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_transaction_type_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_transaction_type_tv" />

            <TextView
                android:id="@+id/profile_invoking_method_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_invoking_method"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_transaction_type_value_tv" />

            <TextView
                android:id="@+id/profile_invoking_method_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Invoking Method"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_invoking_method_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_invoking_method_tv" />



            <TextView
                android:id="@+id/profile_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_amount"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_invoking_method_value_tv" />

            <TextView
                android:id="@+id/profile_amount_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Amount"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_amount_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_amount_tv" />

            <TextView
                android:id="@+id/profile_payment_reference_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_payment_reference"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_amount_value_tv" />

            <TextView
                android:id="@+id/profile_payment_reference_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Payment Reference"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_payment_reference_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_payment_reference_tv" />


            <TextView
                android:id="@+id/profile_account_number_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_account_number"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_payment_reference_value_tv" />

            <TextView
                android:id="@+id/profile_account_number_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Account Number"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_account_number_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_account_number_tv" />


            <TextView
                android:id="@+id/profile_id_number_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_id_number"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_account_number_value_tv" />

            <TextView
                android:id="@+id/profile_id_number_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="ID Number"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_id_number_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_id_number_tv" />

            <TextView
                android:id="@+id/profile_max_collection_amount_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_max_collection_amount"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_id_number_value_tv" />

            <TextView
                android:id="@+id/profile_max_collection_amount_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Max Collection Amount"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_max_collection_amount_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_max_collection_amount_tv" />

            <TextView
                android:id="@+id/profile_debit_order_day_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_debit_order_day"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_max_collection_amount_value_tv" />

            <TextView
                android:id="@+id/profile_debit_order_day_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Debit Order Day"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_debit_order_day_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_debit_order_day_tv" />

            <TextView
                android:id="@+id/profile_creditor_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_creditor"
                android:textColor="#808080"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/profile_debit_order_day_value_tv" />

            <TextView
                android:id="@+id/profile_creditor_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Creditor"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_creditor_tv"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_creditor_tv" />

            <TextView
                android:id="@+id/profile_contract_reference_number_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="10dp"
                android:text="@string/profile_completed_textview_contract_reference_number"
                android:textColor="#808080"
                android:textStyle="bold"
