                app:layout_constraintTop_toBottomOf="@+id/profile_creditor_value_tv" />

            <TextView
                android:id="@+id/profile_contract_reference_number_value_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:text="Contract Reference Number"
                android:textColor="@color/black"
                app:layout_constraintBottom_toBottomOf="@+id/profile_contract_reference_number_tv"
